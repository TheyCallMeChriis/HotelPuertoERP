PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://pos_admin:REEMPLAZAR_PASSWORD_URL_ENCODED@127.0.0.1:5432/pos_erp_hotel?schema=public"
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# Solo se usan al ejecutar explícitamente el seed de demostración.
SEED_ADMIN_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
# Opcional: habilita el registro de un administrador desde la pantalla de inicio cuando ya existen administradores.
# Use un código largo y bórrelo después de registrarse. Sin administradores activos, el registro no pide código.
SETUP_TOKEN=""

# Adaptador de integración con el PMS (PMS-001). "simulado" mientras no exista la API real del hotel.
PMS_ADAPTER="simulado"
