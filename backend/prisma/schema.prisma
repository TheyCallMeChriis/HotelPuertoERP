generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SECURITY AND ACCESS (RBAC + AUDIT)
// ==========================================

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  nombre       String
  email        String      @unique
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  roles                 UserRole[]
  auditLogs             AuditLog[]
  ventasRealizadas      Sale[]             @relation("VentaUsuario")
  ventasAnuladas        Sale[]             @relation("VentaAnuladaUsuario")
  aperturasCaja         CashShift[]
  movimientosCaja       CashMovement[]
  movimientosInventario InventoryMovement[]
  trasladosRealizados   WarehouseTransfer[]
  ajustesRealizados     InventoryAdjustment[] @relation("AjusteCreador")
  ajustesAprobados      InventoryAdjustment[] @relation("AjusteAprobador")
  ordenesCompra         PurchaseOrder[]
  recepcionesCompra     PurchaseReceipt[]
  ventasSuspendidas     SuspendedSale[]
  tomasFisicas          PhysicalCount[]  @relation("TomaCreador")
  tomasAplicadas        PhysicalCount[]  @relation("TomaAplicador")

  abonosRegistrados CustomerPayment[] @relation("AbonoUsuario")
  abonosAnulados    CustomerPayment[] @relation("AbonoAnuladoUsuario")

  solicitudesCompra PurchaseRequest[] @relation("SolicitudSolicitante")
  solicitudesRevisadas PurchaseRequest[] @relation("SolicitudRevisor")

  notasCredito      CreditNote[] @relation("NotaCreditoUsuario")
  @@map("usuarios")
}

model Role {
  id          String         @id @default(cuid())
  nombre      String         @unique
  descripcion String?
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  modulo      String           // e.g. "VENTAS", "CAJA", "INVENTARIO", "COMPRAS", "USUARIOS"
  accion      String           // e.g. "VER", "CREAR", "EDITAR", "ANULAR", "DESCUENTOS"
  descripcion String?

  roles       RolePermission[]

  @@unique([modulo, accion])
  @@map("permisos")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("usuario_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("rol_permisos")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  accion    String   // e.g. "LOGIN", "VENTA_CREADA", "VENTA_ANULADA", "AJUSTE_INVENTARIO"
  entidad   String   // e.g. "Sale", "InventoryMovement", "CashShift"
  entidadId String?
  detalle   String?  @db.Text
  ip        String?
  fecha     DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("bitacora_auditoria")
}

// ==========================================
// 2. COMMERCIAL CATALOGS
// ==========================================

model Category {
  id          String    @id @default(cuid())
  nombre      String    @unique
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  products    Product[]

  @@map("categorias")
}

model Product {
  id           String      @id @default(cuid())
  codigo       String      @unique
  nombre       String
  descripcion  String?
  categoriaId  String
  precioVenta  Decimal     @db.Decimal(12, 2)
  costo        Decimal     @default(0.00) @db.Decimal(12, 2)
  impuesto     Decimal     @default(13.00) @db.Decimal(5, 2) // default VAT %
  codigoBarras String?
  esServicio   Boolean     @default(false)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  categoria             Category                @relation(fields: [categoriaId], references: [id])
  saleDetails           SaleDetail[]
  stock                 Stock[]
  inventoryMovements    InventoryMovement[]
  transferDetails       WarehouseTransferDetail[]
  adjustmentDetails     InventoryAdjustmentDetail[]
  purchaseOrderDetails  PurchaseOrderDetail[]
  receiptDetails        PurchaseReceiptDetail[]
  physicalCountDetails  PhysicalCountDetail[]

  solicitudesCompra PurchaseRequestDetail[]
  devoluciones      CreditNoteDetail[]
  @@map("productos")
}

model Customer {
  id                 String   @id @default(cuid())
  tipoIdentificacion String   @default("CEDULA_FISICA") // CEDULA_FISICA, CEDULA_JURIDICA (company), DIMEX, PASAPORTE
  identificacion     String   @unique
  nombre             String
  email              String?
  telefono           String?
  direccion          String?
  limiteCredito      Decimal  @default(0.00) @db.Decimal(12, 2)
  diasCredito        Int      @default(0)
  creditoActivo      Boolean  @default(false)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  contacto      String?  // contact person when the customer is a company (CLI-001)
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  ventas             Sale[]
  ventasSuspendidas  SuspendedSale[]
  abonos             CustomerPayment[]

  @@map("clientes")
}

// ==========================================
// 3. POINTS OF SALE, CASH REGISTERS AND SHIFTS
// ==========================================

model CashRegister {
  id        String       @id @default(cuid())
  codigo    String       @unique
  nombre    String
  ubicacion String?
  activo    Boolean      @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  shifts    CashShift[]
  points    PointOfSale[]

  @@map("cajas")
}

model PointOfSale {
  id               String       @id @default(cuid())
  codigo           String       @unique
  nombre           String
  departamento     String       // e.g. "RESTAURANTE", "BAR", "RECEPCION", "SOUVENIRS"
  cajaId           String
  bodegaDefectoId  String
  activo           Boolean      @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  caja             CashRegister @relation(fields: [cajaId], references: [id])
  bodegaDefecto    Warehouse    @relation(fields: [bodegaDefectoId], references: [id])
  ventas           Sale[]
  ventasSuspendidas SuspendedSale[]

  @@map("puntos_venta")
}

// Operating departments (GEN-004). PointOfSale.departamento stores the code.
model Department {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  @@map("departamentos")
}

model CashShift {
  id              String         @id @default(cuid())
  cajaId          String
  usuarioId       String
  fechaApertura   DateTime       @default(now())
  montoInicial    Decimal        @db.Decimal(12, 2)
  fechaCierre     DateTime?
  montoContado    Decimal?       @db.Decimal(12, 2)
  montoEsperado   Decimal?       @db.Decimal(12, 2)
  diferencia      Decimal?       @db.Decimal(12, 2) // Overage (+) or shortage (-)
  estado          String         @default("ABIERTA") // "ABIERTA", "CERRADA"
  notas           String?

  caja            CashRegister   @relation(fields: [cajaId], references: [id])
  usuario         User           @relation(fields: [usuarioId], references: [id])
  movements       CashMovement[]
  ventas          Sale[]
  abonos          CustomerPayment[]
  notasCredito    CreditNote[]

  @@map("aperturas_caja")
}

model CashMovement {
  id            String    @id @default(cuid())
  cashShiftId   String
  usuarioId     String
  tipo          String    // "ENTRADA_EXTRAORDINARIA", "SALIDA_EXTRAORDINARIA"
  monto         Decimal   @db.Decimal(12, 2)
  motivo        String
  fecha         DateTime  @default(now())

  cashShift     CashShift @relation(fields: [cashShiftId], references: [id])
  usuario       User      @relation(fields: [usuarioId], references: [id])

  @@map("movimientos_caja")
}

// ==========================================
// 4. SALES, LINE ITEMS AND PAYMENT METHODS
// ==========================================

model PaymentMethod {
  id        String        @id @default(cuid())
  codigo    String        @unique // "EFECTIVO", "TARJETA", "SINPE_MOVIL", "CREDITO", "CARGO_HABITACION"
  nombre    String
  activo    Boolean       @default(true)

  pagos     SalePayment[]
  abonos    CustomerPayment[]

  notasCredito   CreditNote[]
  @@map("formas_pago")
}

model Sale {
  id                 String        @id @default(cuid())
  consecutivo        String        @unique // e.g. "VTA-000001"
  cashShiftId        String
  pointOfSaleId      String
  usuarioId          String
  customerId         String?
  subtotal           Decimal       @db.Decimal(12, 2)
  descuento          Decimal       @default(0.00) @db.Decimal(12, 2)
  impuesto           Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  estado             String        @default("COMPLETADA") // "COMPLETADA", "ANULADA", "SUSPENDIDA"
  motivoAnulacion    String?
  usuarioAnulacionId String?
  fechaAnulacion     DateTime?
  notas              String?
  fechaVencimiento   DateTime?     // credit sales: sale date + customer credit term (CLI-006)
  impresiones        Int           @default(1) // 1 = original print; reprints are marked as copies (FAC-006)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  cashShift          CashShift     @relation(fields: [cashShiftId], references: [id])
  pointOfSale        PointOfSale   @relation(fields: [pointOfSaleId], references: [id])
  usuario            User          @relation("VentaUsuario", fields: [usuarioId], references: [id])
  usuarioAnulacion   User?         @relation("VentaAnuladaUsuario", fields: [usuarioAnulacionId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  details            SaleDetail[]
  payments           SalePayment[]
  cargoHabitacion    RoomCharge?
  abonosAplicados    CustomerPaymentApplication[]
  notasCredito       CreditNote[]

  @@map("ventas")
}

model SaleDetail {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  cantidad       Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal  @db.Decimal(12, 2)
  descuento      Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  impuesto       Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  notas          String?

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  devoluciones   CreditNoteDetail[]

  @@map("detalle_ventas")
}

// Credit note: full or partial reversal of a sale through an authorized flow (FAC-005).
// It never modifies the original sale: it offsets it with its own linked document.
model CreditNote {
  id                   String        @id @default(cuid())
  consecutivo          String        @unique // NC-000001
  saleId               String
  usuarioId            String
  tipo                 String        // TOTAL, PARCIAL
  motivo               String
  subtotal             Decimal       @db.Decimal(12, 2)
  impuesto             Decimal       @db.Decimal(12, 2)
  total                Decimal       @db.Decimal(12, 2)
  paymentMethodId      String        // payment method used to refund the money
  cashShiftId          String?       // shift the refunded cash is taken from
  referencia           String?
  reintegraInventario  Boolean       @default(true)
  impresiones          Int           @default(1)
  createdAt            DateTime      @default(now())

  sale                 Sale          @relation(fields: [saleId], references: [id])
  usuario              User          @relation("NotaCreditoUsuario", fields: [usuarioId], references: [id])
  paymentMethod        PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  cashShift            CashShift?    @relation(fields: [cashShiftId], references: [id])
  details              CreditNoteDetail[]

  @@index([saleId])
  @@map("notas_credito")
}

model CreditNoteDetail {
  id            String     @id @default(cuid())
  creditNoteId  String
  saleDetailId  String
  productId     String
  cantidad      Decimal    @db.Decimal(12, 3)
  subtotal      Decimal    @db.Decimal(12, 2)
  impuesto      Decimal    @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)

  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  saleDetail    SaleDetail @relation(fields: [saleDetailId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@map("detalle_notas_credito")
}

// Suspended sales (POS-006): cart draft with no sequence number and no payments;
// it does not touch cash or inventory. Deleted when completed or discarded.
model SuspendedSale {
  id            String      @id @default(cuid())
  pointOfSaleId String
  usuarioId     String
  customerId    String?
  etiqueta      String
  notas         String?
  items         Json
  createdAt     DateTime    @default(now())

  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id])
  usuario       User        @relation(fields: [usuarioId], references: [id])
  customer      Customer?   @relation(fields: [customerId], references: [id])

  @@index([pointOfSaleId])
  @@map("ventas_suspendidas")
}

model SalePayment {
  id              String        @id @default(cuid())
  saleId          String
  paymentMethodId String
  monto           Decimal       @db.Decimal(12, 2)
  referencia      String?       // Card voucher, transfer number, etc.
  createdAt       DateTime      @default(now())

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("pagos_venta")
}

// Accounts receivable (CLI-005/006): customer payments applied to credit sales
model CustomerPayment {
  id                 String    @id @default(cuid())
  consecutivo        String    @unique // ABO-000001
  customerId         String
  usuarioId          String
  paymentMethodId    String
  cashShiftId        String?   // shift that received the money (required for cash)
  monto              Decimal   @db.Decimal(12, 2)
  referencia         String?
  notas              String?
  estado             String    @default("APLICADO") // APLICADO, ANULADO
  motivoAnulacion    String?
  usuarioAnulacionId String?
  fechaAnulacion     DateTime?
  createdAt          DateTime  @default(now())

  customer           Customer      @relation(fields: [customerId], references: [id])
  usuario            User          @relation("AbonoUsuario", fields: [usuarioId], references: [id])
  usuarioAnulacion   User?         @relation("AbonoAnuladoUsuario", fields: [usuarioAnulacionId], references: [id])
  paymentMethod      PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  cashShift          CashShift?    @relation(fields: [cashShiftId], references: [id])
  aplicaciones       CustomerPaymentApplication[]

  @@index([customerId])
  @@map("abonos_clientes")
}

// Portion of a customer payment applied to one credit sale
model CustomerPaymentApplication {
  id        String          @id @default(cuid())
  paymentId String
  saleId    String
  monto     Decimal         @db.Decimal(12, 2)

  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale      Sale            @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("aplicaciones_abonos")
}

// ==========================================
// 5. INVENTORY, MULTI-WAREHOUSE AND STOCK LEDGER (KARDEX)
// ==========================================

model Warehouse {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  ubicacion   String?
  activo      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  stocks              Stock[]
  puntosVenta         PointOfSale[]
  movimientos         InventoryMovement[]
  trasladosOrigen     WarehouseTransfer[]   @relation("BodegaOrigen")
  trasladosDestino    WarehouseTransfer[]   @relation("BodegaDestino")
  ajustes             InventoryAdjustment[]
  ordenesCompra       PurchaseOrder[]
  recepcionesCompra   PurchaseReceipt[]
  tomasFisicas        PhysicalCount[]

  solicitudesCompra PurchaseRequest[]
  @@map("bodegas")
}

model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  cantidad    Decimal   @default(0.000) @db.Decimal(12, 3)
  stockMinimo Decimal   @default(0.000) @db.Decimal(12, 3)
  stockMaximo Decimal   @default(1000.000) @db.Decimal(12, 3)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("existencias")
}

model InventoryMovement {
  id                  String    @id @default(cuid())
  warehouseId         String
  productId           String
  tipo                String    // ENTRADA_COMPRA, ENTRADA_MANUAL, ENTRADA_DEVOLUCION, SALIDA_VENTA, SALIDA_MANUAL, TRASLADO_SALIDA, TRASLADO_ENTRADA, AJUSTE_POSITIVO, AJUSTE_NEGATIVO, MERMA
  cantidad            Decimal   @db.Decimal(12, 3)
  saldoAnterior       Decimal   @db.Decimal(12, 3)
  saldoNuevo          Decimal   @db.Decimal(12, 3)
  costoUnitario       Decimal   @default(0.00) @db.Decimal(12, 2)
  documentoReferencia String?   // Sequence number of the sale, order or transfer
  motivo              String?
  usuarioId           String
  fecha               DateTime  @default(now())

  warehouse           Warehouse @relation(fields: [warehouseId], references: [id])
  product             Product   @relation(fields: [productId], references: [id])
  usuario             User      @relation(fields: [usuarioId], references: [id])

  @@map("movimientos_inventario")
}

model WarehouseTransfer {
  id                 String                    @id @default(cuid())
  consecutivo        String                    @unique // e.g. "TRF-000001"
  warehouseOrigenId  String
  warehouseDestinoId String
  usuarioId          String
  estado             String                    @default("COMPLETADO") // PENDIENTE, COMPLETADO, CANCELADO
  notas              String?
  createdAt          DateTime                  @default(now())

  warehouseOrigen    Warehouse                 @relation("BodegaOrigen", fields: [warehouseOrigenId], references: [id])
  warehouseDestino   Warehouse                 @relation("BodegaDestino", fields: [warehouseDestinoId], references: [id])
  usuario            User                      @relation(fields: [usuarioId], references: [id])
  details            WarehouseTransferDetail[]

  @@map("traslados_bodega")
}

model WarehouseTransferDetail {
  id         String            @id @default(cuid())
  transferId String
  productId  String
  cantidad   Decimal           @db.Decimal(12, 3)

  transfer   WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])

  @@map("detalle_traslados")
}

model InventoryAdjustment {
  id           String                      @id @default(cuid())
  consecutivo  String                      @unique // e.g. "AJU-000001"
  warehouseId  String
  tipo         String                      // "POSITIVO", "NEGATIVO"
  motivo       String
  usuarioId    String
  aprobadorId  String?
  createdAt    DateTime                    @default(now())

  warehouse    Warehouse                   @relation(fields: [warehouseId], references: [id])
  usuario      User                        @relation("AjusteCreador", fields: [usuarioId], references: [id])
  aprobador    User?                       @relation("AjusteAprobador", fields: [aprobadorId], references: [id])
  details      InventoryAdjustmentDetail[]

  @@map("ajustes_inventario")
}

model InventoryAdjustmentDetail {
  id            String              @id @default(cuid())
  adjustmentId  String
  productId     String
  cantidad      Decimal             @db.Decimal(12, 3)
  costoUnitario Decimal             @db.Decimal(12, 2)

  adjustment    InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id])

  @@map("detalle_ajustes")
}

// Physical inventory count (INV-007): system quantities are frozen when the count starts,
// counts are recorded, and applying the count adjusts each difference through ledger movements.
model PhysicalCount {
  id              String                @id @default(cuid())
  consecutivo     String                @unique // e.g. "TF-000001"
  warehouseId     String
  estado          String                @default("ABIERTA") // ABIERTA, APLICADA, ANULADA
  notas           String?
  usuarioId       String
  aplicadoPorId   String?
  fechaInicio     DateTime              @default(now())
  fechaAplicacion DateTime?

  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  usuario         User                  @relation("TomaCreador", fields: [usuarioId], references: [id])
  aplicadoPor     User?                 @relation("TomaAplicador", fields: [aplicadoPorId], references: [id])
  details         PhysicalCountDetail[]

  @@index([warehouseId, estado])
  @@map("tomas_fisicas")
}

model PhysicalCountDetail {
  id               String        @id @default(cuid())
  physicalCountId  String
  productId        String
  cantidadSistema  Decimal       @db.Decimal(12, 3)
  cantidadContada  Decimal?      @db.Decimal(12, 3)
  cantidadAjustada Decimal?      @db.Decimal(12, 3)

  physicalCount    PhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@unique([physicalCountId, productId])
  @@map("detalle_tomas_fisicas")
}

// ==========================================
// 6. PURCHASING AND SUPPLIERS
// ==========================================

model Supplier {
  id             String          @id @default(cuid())
  identificacion String          @unique
  nombre         String
  razonSocial    String?
  email          String?
  telefono       String?
  direccion      String?
  diasCredito    Int             @default(0)
  condicionesPago String?        // e.g. "Cash", "30-day credit against invoice" (COM-009)
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creadoPor     String?  // user who created the record (GEN-008)
  modificadoPor String?  // last user who modified the record (GEN-008)

  purchaseOrders PurchaseOrder[]

  @@map("proveedores")
}

model PurchaseOrder {
  id             String                @id @default(cuid())
  consecutivo    String                @unique // e.g. "OC-000001"
  supplierId     String
  warehouseId    String
  usuarioId      String
  fechaEmision   DateTime              @default(now())
  fechaEsperada  DateTime?
  estado         String                @default("APROBADA") // BORRADOR, APROBADA, RECIBIDA_PARCIAL, RECIBIDA_TOTAL, CANCELADA
  subtotal       Decimal               @db.Decimal(12, 2)
  impuesto       Decimal               @db.Decimal(12, 2)
  total          Decimal               @db.Decimal(12, 2)
  notas          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  usuario        User                  @relation(fields: [usuarioId], references: [id])
  details        PurchaseOrderDetail[]
  receipts       PurchaseReceipt[]
  solicitudes    PurchaseRequest[]

  @@map("ordenes_compra")
}

// Internal purchase requests with approval (COM-002, COM-003)
// PENDIENTE -> APROBADA -> CONVERTIDA (into a purchase order) | RECHAZADA | CANCELADA
model PurchaseRequest {
  id                   String    @id @default(cuid())
  consecutivo          String    @unique // SC-000001
  solicitanteId        String
  warehouseId          String    // warehouse that will receive the goods
  departamento         String?
  justificacion        String
  prioridad            String    @default("NORMAL") // NORMAL, URGENTE
  estado               String    @default("PENDIENTE")
  revisorId            String?
  fechaRevision        DateTime?
  comentarioRevision   String?
  purchaseOrderId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  solicitante          User           @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id])
  revisor              User?          @relation("SolicitudRevisor", fields: [revisorId], references: [id])
  warehouse            Warehouse      @relation(fields: [warehouseId], references: [id])
  purchaseOrder        PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  details              PurchaseRequestDetail[]

  @@index([estado])
  @@map("solicitudes_compra")
}

model PurchaseRequestDetail {
  id                String          @id @default(cuid())
  purchaseRequestId String
  productId         String
  cantidad          Decimal         @db.Decimal(12, 3)
  notas             String?

  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])

  @@map("detalle_solicitudes_compra")
}

model PurchaseOrderDetail {
  id                 String        @id @default(cuid())
  purchaseOrderId    String
  productId          String
  cantidadSolicitada Decimal       @db.Decimal(12, 3)
  cantidadRecibida   Decimal       @default(0.000) @db.Decimal(12, 3)
  precioUnitario     Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)

  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@map("detalle_ordenes_compra")
}

model PurchaseReceipt {
  id               String                  @id @default(cuid())
  consecutivo      String                  @unique // e.g. "REC-000001"
  purchaseOrderId  String
  facturaProveedor String?
  warehouseId      String
  usuarioId        String
  fechaRecepcion   DateTime                @default(now())
  notas            String?

  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id])
  usuario          User                    @relation(fields: [usuarioId], references: [id])
  details          PurchaseReceiptDetail[]

  @@map("recepciones_compra")
}

model PurchaseReceiptDetail {
  id               String          @id @default(cuid())
  receiptId        String
  productId        String
  cantidadRecibida Decimal         @db.Decimal(12, 3)
  costoUnitario    Decimal         @db.Decimal(12, 2)
  costoAnterior    Decimal?        @db.Decimal(12, 2) // product cost before this receipt (INV-011)
  costoNuevo       Decimal?        @db.Decimal(12, 2) // resulting cost according to the configured costing method

  receipt          PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])

  @@map("detalle_recepciones")
}

// ==========================================
// 7. HOTEL INTEGRATION / PMS
// ==========================================

model Room {
  id          String        @id @default(cuid())
  numero      String        @unique // e.g. "101", "102"
  tipo        String        // e.g. "ESTANDAR", "SUITE", "VILLA"
  estado      String        @default("DISPONIBLE") // DISPONIBLE, OCUPADA, MANTENIMIENTO
  activo      Boolean       @default(true)

  guests      Guest[]
  roomCharges RoomCharge[]

  @@map("habitaciones")
}

model Guest {
  id             String       @id @default(cuid())
  identificacion String       @unique
  nombreCompleto String
  habitacionId   String
  checkIn        DateTime     @default(now())
  checkOut       DateTime?
  estado         String       @default("HOSPEDADO") // HOSPEDADO, SALIO

  habitacion     Room         @relation(fields: [habitacionId], references: [id])
  roomCharges    RoomCharge[]

  @@map("huespedes")
}

model RoomCharge {
  id              String                @id @default(cuid())
  saleId          String?               @unique
  roomId          String
  guestId         String
  monto           Decimal               @db.Decimal(12, 2)
  transaccionUuid String                @unique // Unique idempotency token that prevents duplicate charges (PMS-005)
  estadoPMS       String                @default("PENDIENTE") // PENDIENTE, CONFIRMADO, ERROR, ANULADO (simulator)
  reintentos      Int                   @default(0)
  respuestaPMS    String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  room            Room                  @relation(fields: [roomId], references: [id])
  guest           Guest                 @relation(fields: [guestId], references: [id])
  queueItems      PMSIntegrationQueue[]

  @@map("cargos_habitacion")
}

model PMSIntegrationQueue {
  id           String     @id @default(cuid())
  roomChargeId String
  endpoint     String
  payload      String     @db.Text
  intentos     Int        @default(0)
  estado       String     @default("PENDIENTE") // PENDIENTE, PROCESADO, FALLIDO, CANCELADO
  ultimoError  String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roomCharge   RoomCharge @relation(fields: [roomChargeId], references: [id], onDelete: Cascade)

  @@map("cola_integracion_pms")
}

// ==========================================
// 8. SYSTEM CONFIGURATION AND PARAMETERS
// ==========================================

model SystemParameter {
  id          String   @id @default(cuid())
  clave       String   @unique // e.g. "HOTEL_NAME", "DEFAULT_TAX_RATE", "CURRENCY_SYMBOL"
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@map("parametros_sistema")
}
